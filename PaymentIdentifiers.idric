iban_remainder : ℕ → List Char → Maybe ℕ
iban_remainder remainder [] = Just remainder
iban_remainder remainder (character :: remaining) =
  case iban_decimal_value character of
    Nothing => Nothing
    Just value =>
      let multiplier = if value < 10 then 10 else 100
          next = mod (remainder * multiplier + value) 97
      in iban_remainder next remaining

iban_checksum_valid : List Char → Bool
iban_checksum_valid (a :: b :: c :: d :: remaining) =
  case iban_remainder 0 (remaining ++ [a, b, c, d]) of
    Just 1 => True
    _ => False
iban_checksum_valid _ = False

public export
iban_text : Iban → String
iban_text iban = iban.iban_value

public export
parse_iban : String → Either String Iban
parse_iban text =
  let characters = unpack text in
    if not (iban_shape characters)
      then Left "IBAN must contain two uppercase country letters, two check digits, and an alphanumeric BBAN"
      else case registered_iban_length characters of
        Nothing => Left "IBAN country code is not in the supported SWIFT registry"
        Just expected =>
          if not (length characters == expected)
            then Left "IBAN length does not match its registered country format"
            else if iban_checksum_valid characters
              then Right (MkIban text)
              else Left "IBAN checksum is invalid"

public export
iban_account : String → Either String AccountIdentification
iban_account text = do
  iban <- parse_iban text
  pure (IbanAccount iban)

public export
other_account : String → Either String AccountIdentification
other_account text = do
  account <- parse_account text
  pure (OtherAccount account)

public export
account_identification_text : AccountIdentification → String
account_identification_text (IbanAccount iban) = iban_text iban
account_identification_text (OtherAccount account) = account_text account
