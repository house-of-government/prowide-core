iban_shape : List Char → Bool
iban_shape (country_a :: country_b :: check_a :: check_b :: bban) =
  upper_alpha country_a &&
  upper_alpha country_b &&
  ascii_digit check_a &&
  ascii_digit check_b &&
  all_iban_alphanumeric bban
iban_shape _ = False

