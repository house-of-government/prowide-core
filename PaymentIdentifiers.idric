module PaymentIdentifiers

%default total

public export
record Bic where
  constructor MkBic
  bic_value : String

public export
record Account where
  constructor MkAccount
  account_value : String

public export
record Iban where
  constructor MkIban
  iban_value : String

public export
data AccountIdentification
  = IbanAccount Iban
  | OtherAccount Account

upper_alpha : Char → Bool
upper_alpha character = character >= 'A' && character <= 'Z'

lower_alpha : Char → Bool
lower_alpha character = character >= 'a' && character <= 'z'

ascii_digit : Char → Bool
ascii_digit character = character >= '0' && character <= '9'

upper_alphanumeric : Char → Bool
upper_alphanumeric character = upper_alpha character || ascii_digit character

iban_alphanumeric : Char → Bool
iban_alphanumeric character =
  upper_alpha character || lower_alpha character || ascii_digit character

all_iban_alphanumeric : List Char → Bool
all_iban_alphanumeric [] = True
all_iban_alphanumeric (character :: remaining) =
  iban_alphanumeric character && all_iban_alphanumeric remaining

bic_core_shape :
  (Char → Bool) →
  Char → Char → Char → Char →
  Char → Char → Char → Char →
  Bool
bic_core_shape party_character a b c d e f g h =
  party_character a &&
  party_character b &&
  party_character c &&
  party_character d &&
  upper_alpha e &&
  upper_alpha f &&
  upper_alphanumeric g &&
  upper_alphanumeric h

bic_shape : (Char → Bool) → List Char → Bool
bic_shape party_character [a, b, c, d, e, f, g, h] =
  bic_core_shape party_character a b c d e f g h
bic_shape party_character [a, b, c, d, e, f, g, h, i, j, k] =
  bic_core_shape party_character a b c d e f g h &&
  upper_alphanumeric i &&
  upper_alphanumeric j &&
  upper_alphanumeric k
bic_shape _ _ = False

public export
bic_text : Bic → String
bic_text bic = bic.bic_value

public export
parse_bic : String → Either String Bic
parse_bic text =
  if bic_shape upper_alphanumeric (unpack text)
    then Right (MkBic text)
    else Left "BIC must be 8 or 11 uppercase alphanumeric characters with a two-letter country code"

public export
parse_fin_bic : String → Either String Bic
parse_fin_bic text =
  if bic_shape upper_alpha (unpack text)
    then Right (MkBic text)
    else Left "FIN BIC must match 4 letters, 2 country letters, 2 uppercase alphanumerics, and an optional 3-character branch"

contains_line_break : List Char → Bool
contains_line_break [] = False
contains_line_break ('\r' :: _) = True
contains_line_break ('\n' :: _) = True
contains_line_break (_ :: remaining) = contains_line_break remaining

public export
account_text : Account → String
account_text account = account.account_value

public export
parse_account : String → Either String Account
parse_account "" = Left "account identifier is empty"
parse_account text =
  if contains_line_break (unpack text)
    then Left "account identifier contains a line break"
    else Right (MkAccount text)

