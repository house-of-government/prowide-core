module Mt.Types

%default total

public export
record MtField where
  constructor MkMtField
  field_tag : String
  field_value : String

public export
record SwiftEnvelope where
  constructor MkSwiftEnvelope
  envelope_basic_header : String
  envelope_application_header : String
  envelope_user_header : Maybe String
  envelope_text : List MtField
  envelope_trailer : Maybe String

public export
record MT103 where
  constructor MkMT103
  mt103_basic_header : String
  mt103_application_header : String
  transaction_reference : String
  bank_operation_code : String
  value_date_currency_amount : String
  ordering_customer : String
  beneficiary_customer : String
  details_of_charges : String

public export
mt103_envelope : MT103 → SwiftEnvelope
mt103_envelope message =
  MkSwiftEnvelope
    message.mt103_basic_header
    message.mt103_application_header
    Nothing
    [ MkMtField "20" message.transaction_reference
    , MkMtField "23B" message.bank_operation_code
    , MkMtField "32A" message.value_date_currency_amount
    , MkMtField "50K" message.ordering_customer
    , MkMtField "59" message.beneficiary_customer
    , MkMtField "71A" message.details_of_charges
    ]
    Nothing
