module Main

import Mt
import System

%default total

sample_mt103 : MT103
sample_mt103 =
  MkMT103
    "F01BANKBEBBAXXX0000000000"
    "I103BANKDEFFXXXXN"
    "REFERENCE123"
    "CRED"
    (MkValueDateCurrencyAmount "260906" "USD" "1234,56")
    (OrderingCustomerK "/12345678 JOHN CUSTOMER")
    (BeneficiaryCustomerNoOption "/87654321 JANE BENEFICIARY")
    "SHA"

expected_fin : String
expected_fin =
  "{1:F01BANKBEBBAXXX0000000000}" ++
  "{2:I103BANKDEFFXXXXN}" ++
  "{4:\r\n" ++
  ":20:REFERENCE123\r\n" ++
  ":23B:CRED\r\n" ++
  ":32A:260906USD1234,56\r\n" ++
  ":50K:/12345678 JOHN CUSTOMER\r\n" ++
  ":59:/87654321 JANE BENEFICIARY\r\n" ++
  ":71A:SHA\r\n" ++
  "-}"

alternative_fields : List MtField
alternative_fields =
  [ MkMtField "20" "REFERENCE-ALT"
  , MkMtField "23B" "CRED"
  , MkMtField "32A" "260906EUR10,00"
  , MkMtField "50A" "/12345678\r\nBANKBEBBXXX"
  , MkMtField "59F" "/12345678\r\n1/BENEFICIARY"
  , MkMtField "71A" "OUR"
  ]

alternative_fin : String
alternative_fin =
  "{1:F01BANKBEBBAXXX0000000000}" ++
  "{2:I103BANKDEFFXXXXN}" ++
  "{4:\r\n" ++
  ":20:REFERENCE-ALT\r\n" ++
  ":23B:CRED\r\n" ++
  ":32A:260906EUR10,00\r\n" ++
  ":50A:/12345678\r\nBANKBEBBXXX\r\n" ++
  ":59F:/12345678\r\n1/BENEFICIARY\r\n" ++
  ":71A:OUR\r\n" ++
  "-}"

multiline_fin : String
multiline_fin =
  "{1:F01BANKBEBBAXXX0000000000}" ++
  "{2:I103BANKDEFFXXXXN}" ++
  "{3:{108:USER-REFERENCE}}" ++
  "{4:\r\n" ++
  ":20:REFERENCE123\r\n" ++
  ":70:LINE ONE\r\n" ++
  "LINE TWO\r\n" ++
  "-}" ++
  "{5:{CHK:ABCDEF123456}}"

mt103_writer : Bool
mt103_writer = render_mt103 sample_mt103 == expected_fin

field_order : Bool
field_order =
  case (mt103_envelope sample_mt103).envelope_text of
    [ MkMtField "20" _
    , MkMtField "23B" _
    , MkMtField "32A" _
    , MkMtField "50K" _
    , MkMtField "59" _
    , MkMtField "71A" _
    ] => True
    _ => False

fin_round_trip : Bool
fin_round_trip =
  case parse_fin expected_fin of
    Left _ => False
    Right parsed => render_fin parsed == expected_fin

multiline_round_trip : Bool
multiline_round_trip =
  case parse_fin multiline_fin of
    Left _ => False
    Right parsed =>
      parsed.envelope_user_header == Just "{108:USER-REFERENCE}" &&
      parsed.envelope_trailer == Just "{CHK:ABCDEF123456}" &&
      case parsed.envelope_text of
        [ MkMtField "20" "REFERENCE123"
        , MkMtField "70" "LINE ONE\r\nLINE TWO"
        ] => render_fin parsed == multiline_fin
        _ => False

schema_accepts_alternatives : Bool
schema_accepts_alternatives =
  case validate_mt103_fields alternative_fields of
    Left _ => False
    Right () => True

schema_accepts_repetition : Bool
schema_accepts_repetition =
  case validate_mt103_fields
    (alternative_fields ++
      [ MkMtField "13C" "/RNCTIME/1200+0000"
      , MkMtField "13C" "/SNDTIME/1201+0000"
      , MkMtField "23E" "SDVA"
      , MkMtField "23E" "PHOB"
      , MkMtField "71F" "USD1,00"
      , MkMtField "71F" "EUR1,00"
      ]) of
    Left _ => False
    Right () => True

schema_rejects_missing_mandatory : Bool
schema_rejects_missing_mandatory =
  case validate_mt103_fields
    [ MkMtField "20" "REFERENCE"
    , MkMtField "23B" "CRED"
    , MkMtField "32A" "260906USD1,00"
    , MkMtField "50K" "CUSTOMER"
    , MkMtField "71A" "SHA"
    ] of
    Left _ => True
    Right () => False

schema_rejects_duplicate_choice : Bool
schema_rejects_duplicate_choice =
  case validate_mt103_fields (MkMtField "50K" "SECOND CUSTOMER" :: alternative_fields) of
    Left _ => True
    Right () => False

schema_rejects_unknown_field : Bool
schema_rejects_unknown_field =
  case validate_mt103_fields (alternative_fields ++ [MkMtField "99Z" "NOT MT103"]) of
    Left _ => True
    Right () => False

typed_mt103_round_trip : Bool
typed_mt103_round_trip =
  case parse_fin expected_fin of
    Left _ => False
    Right envelope =>
      case mt103_from_envelope envelope of
        Left _ => False
        Right typed => render_mt103 typed == expected_fin

typed_alternative_round_trip : Bool
typed_alternative_round_trip =
  let envelope =
        MkSwiftEnvelope
          "F01BANKBEBBAXXX0000000000"
          "I103BANKDEFFXXXXN"
          Nothing
          alternative_fields
          Nothing
  in case mt103_from_envelope envelope of
    Left _ => False
    Right typed =>
      case (typed.ordering_customer, typed.beneficiary_customer) of
        (OrderingCustomerA party, BeneficiaryCustomerF "/12345678\r\n1/BENEFICIARY") =>
          case party.account of
            Just (OtherAccount account) =>
              account_text account == "12345678" &&
              bic_text party.bic == "BANKBEBBXXX" &&
              typed.value_date_currency_amount.value_date == "260906" &&
              typed.value_date_currency_amount.currency_code == "EUR" &&
              typed.value_date_currency_amount.amount_text == "10,00" &&
              render_mt103 typed == alternative_fin
            _ => False
        _ => False

shared_bic_shape_test : Bool
shared_bic_shape_test =
  case parse_bic "A1CDBEBBXXX" of
    Left _ => False
    Right bic => bic_text bic == "A1CDBEBBXXX"

fin_bic_boundary_test : Bool
fin_bic_boundary_test =
  case ( parse_fin_bic "BANKBEBBXXX"
       , parse_fin_bic "A1CDBEBBXXX"
       , parse_fin_bic "BANKBEBBAXXX"
       ) of
    (Right bic, Left _, Left _) => bic_text bic == "BANKBEBBXXX"
    _ => False

account_boundary_test : Bool
account_boundary_test =
  case (parse_account "123/ABC", parse_account "", parse_account "A\nB") of
    (Right account, Left _, Left _) => account_text account == "123/ABC"
    _ => False

iban_boundary_test : Bool
iban_boundary_test =
  case ( iban_account "DE89370400440532013000"
       , iban_account "DE88370400440532013000"
       , iban_account "DE893704004405320130000"
       , iban_account "ZZ001234567890"
       ) of
    (Right (IbanAccount iban), Left _, Left _, Left _) =>
      iban_text iban == "DE89370400440532013000"
    _ => False

fin_account_is_not_inferred_as_iban : Bool
fin_account_is_not_inferred_as_iban =
  let fields =
        [ MkMtField "20" "REFERENCE"
        , MkMtField "23B" "CRED"
        , MkMtField "32A" "260906EUR10,00"
        , MkMtField "50A" "/DE89370400440532013000\r\nBANKBEBBXXX"
        , MkMtField "59" "BENEFICIARY"
        , MkMtField "71A" "SHA"
        ]
      envelope =
        MkSwiftEnvelope
          "F01BANKBEBBAXXX0000000000"
          "I103BANKDEFFXXXXN"
          Nothing
          fields
          Nothing
  in case mt103_from_envelope envelope of
    Left _ => False
    Right typed =>
      case typed.ordering_customer of
        OrderingCustomerA party =>
          case party.account of
            Just (OtherAccount account) =>
              account_text account == "DE89370400440532013000"
            _ => False
        _ => False

invalid_option_a_rejected : Bool
invalid_option_a_rejected =
  let fields =
        [ MkMtField "20" "REFERENCE"
        , MkMtField "23B" "CRED"
        , MkMtField "32A" "260906USD1,00"
        , MkMtField "50A" "BANKBEBBAXXX"
        , MkMtField "59" "BENEFICIARY"
        , MkMtField "71A" "SHA"
        ]
      envelope = MkSwiftEnvelope "F01BANKBEBBAXXX0000000000" "I103BANKDEFFXXXXN" Nothing fields Nothing
  in case mt103_from_envelope envelope of
    Left _ => True
    Right _ => False

wrong_message_type_rejected : Bool
wrong_message_type_rejected =
  case mt103_from_envelope (MkSwiftEnvelope "F01BANKBEBBAXXX0000000000" "I202BANKDEFFXXXXN" Nothing [] Nothing) of
    Left _ => True
    Right _ => False

check : String → Bool → IO ()
check name True = putStrLn ("ok   " ++ name)
check name False = putStrLn ("FAIL " ++ name)

all_pass : Bool
all_pass =
  mt103_writer &&
  field_order &&
  fin_round_trip &&
  multiline_round_trip &&
  schema_accepts_alternatives &&
  schema_accepts_repetition &&
  schema_rejects_missing_mandatory &&
  schema_rejects_duplicate_choice &&
  schema_rejects_unknown_field &&
  typed_mt103_round_trip &&
  typed_alternative_round_trip &&
  shared_bic_shape_test &&
  fin_bic_boundary_test &&
  account_boundary_test &&
  iban_boundary_test &&
  fin_account_is_not_inferred_as_iban &&
  invalid_option_a_rejected &&
  wrong_message_type_rejected

main : IO ()
main = do
  check "MT103 renders canonical FIN block order" mt103_writer
  check "MT103 fields preserve SWIFT order" field_order
  check "FIN parses and writes without change" fin_round_trip
  check "FIN preserves optional blocks and multiline fields" multiline_round_trip
  check "MT103 schema accepts mandatory field alternatives" schema_accepts_alternatives
  check "MT103 schema accepts generated repetitive fields" schema_accepts_repetition
  check "MT103 schema rejects a missing mandatory field group" schema_rejects_missing_mandatory
  check "MT103 schema rejects two alternatives in a single-choice field group" schema_rejects_duplicate_choice
  check "MT103 schema rejects a field outside the generated MT103 grammar" schema_rejects_unknown_field
  check "generic FIN decodes to typed MT103" typed_mt103_round_trip
  check "typed MT103 option A uses shared account-identification and BIC primitives" typed_alternative_round_trip
  check "shared BIC accepts the ISO 9362 alphanumeric party prefix" shared_bic_shape_test
  check "FIN BIC is stricter and rejects LT-address shape" fin_bic_boundary_test
  check "account primitive refuses empty and multiline identifiers" account_boundary_test
  check "shared IBAN validates registered length and MOD97 checksum" iban_boundary_test
  check "FIN account text is not guessed to be IBAN" fin_account_is_not_inferred_as_iban
  check "typed MT103 rejects a 12-character LT address in option A" invalid_option_a_rejected
  check "typed MT103 decoder rejects another message type" wrong_message_type_rejected
  if all_pass then pure () else exitFailure
